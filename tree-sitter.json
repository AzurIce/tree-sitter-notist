{
  "grammars": [
    {
      "name": "notist",
      "camelcase": "Notist",
      "scope": "source.notist",
      "path": ".",
      "file-types": ["not"],
      "injection-regex": "^(not|notist)$"
    },
    {
      "name": "notist_code",
      "camelcase": "NotistCode",
      "scope": "source.notist_code",
      "path": "notist-code",
      "file-types": ["notc"],
      "injection-regex": "^(notc|notist_code)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT OR Apache-2.0",
    "description": "Notist grammar for tree-sitter",
    "authors": [{ "name": "Notist contributors" }],
    "links": {
      "repository": "https://github.com/AzurIce/tree-sitter-notist"
    }
  },
  "bindings": {
    "rust": true
  }
}
