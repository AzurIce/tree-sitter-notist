          }
        },
        {
          "type": "SYMBOL",
          "name": "string_close"
        }
      ]
    },
    "fenced_raw": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "fence_open"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "language",
              "content": {
                "type": "SYMBOL",
                "name": "fence_info"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_line_break"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "body",
              "content": {
                "type": "SYMBOL",
                "name": "fence_content"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "close",
          "content": {
            "type": "SYMBOL",
            "name": "fence_close"
          }
        }
      ]
    },
    "attributes": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "FIELD",
          "name": "first",
          "content": {
            "type": "SYMBOL",
            "name": "first_attribute"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "FIELD",
                "name": "item",
                "content": {
                  "type": "SYMBOL",
                  "name": "attribute_item"
                }
              }
            ]
          }
        }
      ]
    },
    "first_attribute": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "id_attribute"
        },
        {
          "type": "SYMBOL",
          "name": "attribute_item"
        }
      ]
    },
    "attribute_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "tag_attribute"
        },
        {
          "type": "SYMBOL",
